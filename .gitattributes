# Normalise line endings to LF in the repository regardless of platform.
* text=auto eol=lf

# Evaluation versions hash file bytes; preserve the exact reviewed artifacts.
eval_sets/**/items.jsonl -text
docs/evidence/**/results.jsonl -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Archived patches contain meaningful context-line prefixes, including blank lines.
docs/evidence/**/execution-changes.patch -whitespace

# Windows-specific files keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary / model artifacts (should normally be gitignored anyway).
*.safetensors binary
*.bin binary
*.pt binary
*.onnx binary
*.faiss binary
